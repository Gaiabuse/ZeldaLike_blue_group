  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0405703a95b55694bbce8b9ff47b18c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  formSwitcher: {fileID: 352241043}
  textBox: {fileID: 621960287}
  erasedManager: {fileID: 621960286}
  atkIndicators:
  - {fileID: 1768870673}
  - {fileID: 1608075721}
  - {fileID: 1847948337}
  - {fileID: 1636810410}
  - {fileID: 861289407}
  steps:
  - colliderTrigger: {fileID: 1612775577}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Oh qu\u2019est ce que tu fous ! R\xE9veille toi ! Tu viens \xE0 peine
      de reprendre et tu glandes d\xE9j\xE0..."
    setNumberOfPointsForErased: 0
    changeIndicator: 1
    ativeAtk: 1
    numberOfPointsForErased: 0
    hadUI: 1
    uiObject: {fileID: 1768870673}
  - colliderTrigger: {fileID: 1700577933}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Fais comme d'habitude, nettoie ce r\xEAve et r\xE9cup\xE8re ce foutu
      noyau. Je te surveille."
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 662206931}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Pense bien a check ton t\xE9l\xE9phone pour voir ou tu en es au niveau
      de ton quotas."
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 1141386771}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "C\u2019est nous qui te donnons acc\xE8s \xE0 ta puissance de cr\xE9ation
      alors fais bien ton taff"
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 261345079}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Je te rappelle que tu as un quota \xE0 remplir, alors nettoie ces
      tas de poussi\xE8res !"
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 439222631}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Tiens, j\u2019esp\xE8re que tu ne les as pas oubli\xE9s, eux, ils
      d\xE9gueulassent tout dans les r\xEAves."
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 1305260524}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "T\u2019es d\xE9j\xE0 bless\xE9 ? Bah, sers-toi de ces poussi\xE8res
      \xE9tincelantes pour te soigner. Maintiens A pour te soigner"
    setNumberOfPointsForErased: 0
    changeIndicator: 1
    ativeAtk: 2
    numberOfPointsForErased: 0
    hadUI: 1
    uiObject: {fileID: 1608075721}
  - colliderTrigger: {fileID: 1589093519}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Si tu effaces les \xE9l\xE9ments que tu as cr\xE9\xE9s, tu peux r\xE9cup\xE9rer
      ta puissance de cr\xE9ations."
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 631205111}
    disponibleForms: 00000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Maintiens R1 si tu veux tout effacer d\u2019un coup."
    setNumberOfPointsForErased: 0
    changeIndicator: 0
    ativeAtk: 0
    numberOfPointsForErased: 0
    hadUI: 0
    uiObject: {fileID: 0}
  - colliderTrigger: {fileID: 1976847404}
    disponibleForms: 02000000
    setForm: 1
    form: 2
    asDialogue: 1
    dialogue: "Ah les peluches\u2026 Si tu passes en forme cauchemar, tu pourras
      les ramasser et les recracher, enfin \xE7a, tu le sais d\xE9j\xE0, non ?"
    setNumberOfPointsForErased: 0
    changeIndicator: 1
    ativeAtk: 3
    numberOfPointsForErased: 0
    hadUI: 1
    uiObject: {fileID: 1847948337}
  - colliderTrigger: {fileID: 849952598}
    disponibleForms: 01000000
    setForm: 1
    form: 1
    asDialogue: 1
    dialogue: "Ok, tu vois ce tas de poussi\xE8res au loin, nettoie-le  \xE0 distance
      sous forme onirique"
    setNumberOfPointsForErased: 0
    changeIndicator: 1
    ativeAtk: 4
    numberOfPointsForErased: 0
    hadUI: 1
    uiObject: {fileID: 1636810410}
  - colliderTrigger: {fileID: 2109056450}
    disponibleForms: 000000000200000001000000
    setForm: 0
    form: 0
    asDialogue: 1
    dialogue: "Allez j\u2019suis gentil, je te laisse acc\xE9der \xE0 toute tes formes,
      maintenant fais ton boulot"
    setNumberOfPointsForErased: 0
    changeIndicator: 1
    ativeAtk: 5
    numberOfPointsForErased: 0
    hadUI: 1
    uiObject: {fileID: 861289407}
  chatHistory: {fileID: 1553568492}
